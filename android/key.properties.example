# Copy to android/key.properties (git-ignored) and fill in your upload key.
# Create the keystore once with:
#   keytool -genkey -v -keystore %USERPROFILE%\nawtin-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
# and back it up somewhere safe: losing it means you cannot update the app.
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=C:\\Users\\YOU\\nawtin-upload.jks
